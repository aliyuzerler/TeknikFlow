{
  "extends": "@teknikflow/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src", ".storybook/**/*", "vitest.unit.config.ts", "vitest.stories.config.ts"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
