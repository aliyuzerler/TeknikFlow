// TeknikFlow — Faz 03: kimlik, kiracı izolasyonu, RBAC ve onboarding.
// (Faz 01'nin altyapı meta verisi korunur; iş modelleri kendi fazlarında eklenir.)
// BKZ. docs/DATA_MODEL.md, docs/ROLES_PERMISSIONS.md, ADR-0002, ADR-0003.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Altyapı önyükleme/üretim meta bilgileri. Tenant verisi DEĞİLDİR.
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Kimlik
// ---------------------------------------------------------------------------

/// Kullanıcı hesabı — kiracılardan bağımsız tekil kimlik (e-posta tekil).
/// platformAdmin: kiracı üyeliği OLMADAN platform düzeyinde erişen hesaplar.
model User {
  id              String       @id @default(uuid())
  emailNormalized String       @unique
  /// Argon2id özetı — asla loglanmaz/yanıtta dönmaz.
  passwordHash    String
  displayName     String
  status          UserStatus   @default(ACTIVE)
  /// MFA-hazır model: şema destekler; platform admin için giriş anında zorunlu.
  mfaEnabled      Boolean      @default(false)
  platformAdmin   Boolean      @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships Membership[]
  sessions    Session[]
  refreshTokens RefreshTokenFamily[]
  invitesSent Invitation[] @relation("InvitationInviter")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  @@map("user_status")
}

/// Kiracı (müşteri firma). slug URL'lerde kullanılan benzersiz kısa ad.
model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  timezone     String       @default("Europe/Istanbul")
  locale       String       @default("tr-TR")
  currency     String       @default("TRY")
  settingsJson Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
  branches     Branch[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  customers    Customer[]
  contacts     Contact[]
  serviceLocations ServiceLocation[]
  assets       Asset[]
  assetDocuments AssetDocument[]
  crmEvents    CrmEvent[]
  subscription Subscription?
  roles        Role[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  @@map("tenant_status")
}

/// Kiracı şube (fiziksel lokasyon). RLS ile korunur (bkz. migration).
model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  /// Kiracı içinde benzersiz kısa kod (ör. IST-MRKZ).
  code      String
  address   String?
  timezone  String   @default("Europe/Istanbul")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// Rol şablonu. Sistem rolleri kiracıdan bağımsız (tenantId=null, isSystem);
/// kiracılar yalnızca izin kataloğundan seçerek özel rol üretebilir.
model Role {
  id          String  @id @default(uuid())
  /// Sistem roller için benzersiz anahtar (owner, admin...).
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)
  tenantId    String?
  tenant      Tenant? @relation(fields: [tenantId], references: [id])

  memberships    Membership[]
  invitations    Invitation[]  @relation("InvitationRole")
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// İzin kataloğu — sunucu tarafında tanımlı, kiracılar genişletemez.
model Permission {
  key         String @id
  description String
  category    String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Kiracı üyeliği — kullanıcı ↔ kiracı ↔ rol ↔ şube kapsamı.
/// RLS ile korunur; kiracı bağlamı DAİMA bu kayıttan türetilir (ADR-0003).
model Membership {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  roleId      String
  role        Role             @relation(fields: [roleId], references: [id])
  /// "ALL" ya da ["<branchId>", ...] — şube kapsamı rolden AYRI denetlenir.
  branchScope Json             @default("\"ALL\"")
  status      MembershipStatus @default(INVITED)
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sessions           Session[]
  refreshTokenFamilies RefreshTokenFamily[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@map("memberships")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  @@map("membership_status")
}

/// Web opak oturumu (ADR-0002). tokenHash = sha256(cookie değeri).
/// csrfTokenHash web oturumlarına bağlı CSRF bağlaması.
model Session {
  id            String       @id @default(uuid())
  tokenHash     String       @unique
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  /// null → platform admin oturumu (kiracı bağlamı yok).
  membershipId  String?
  membership    Membership?  @relation(fields: [membershipId], references: [id])
  kind          SessionKind  @default(WEB)
  csrfTokenHash String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime     @default(now())
  createdIp     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  @@index([userId, revokedAt])
  @@map("sessions")
}

enum SessionKind {
  WEB
  MOBILE
  @@map("session_kind")
}

/// Mobil dönen refresh token aileleri (ADR-0002): yeniden kullanım tespiti
/// aile iptali ile sonuçlanır. rotatedAt set = başka bir token'a dönüldü.
model RefreshTokenFamily {
  id              String    @id @default(uuid())
  familyId        String    @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  membershipId    String
  membership      Membership @relation(fields: [membershipId], references: [id])
  tokenHash       String    @unique
  expiresAt       DateTime
  rotatedAt       DateTime?
  reuseDetectedAt DateTime?
  revokedAt       DateTime?
  revokedReason   String?
  createdIp       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token_families")
}

/// Kiracı daveti. tokenHash = sha256(opak token) — token yalnız oluşturulduğunda
/// bir kez API yanıtında döner. E-posta gönderimi Faz 12'de; MVP'de bağlantı yanıtta.
model Invitation {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  emailNormalized  String
  roleId           String
  role             Role      @relation("InvitationRole", fields: [roleId], references: [id])
  branchScope      Json      @default("\"ALL\"")
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  invitedByUserId  String
  invitedBy        User      @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, emailNormalized])
  @@index([tenantId, expiresAt])
  @@map("invitations")
}

/// Audit kaydı — aktör, eylem, kaynak, kiracı, zaman, istek kimliği ve GÜVENLİ
/// fark (parola/token/imza asla metadata'ya girmez). RLS ile korunur.
model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  actorId       String?
  actorType     String   @default("user")
  action        String
  resourceType  String
  resourceId    String?
  requestId     String?
  ip            String?
  userAgent     String?
  metadataJson  Json     @default("{}")
  occurredAt    DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Plan / yetki iskeleti (Faz 14 billing sağlar; şimdilik sunucu tarafı kontroller)
// ---------------------------------------------------------------------------

model Plan {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  entitlements PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

/// plan yetkisi: key (ör. max_users) → limitValue (null = sınırsız) / enabled.
model PlanEntitlement {
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  key        String
  limitValue Int?
  enabled    Boolean @default(true)

  @@id([planId, key])
  @@map("plan_entitlements")
}

/// Kiracı aboneliği iskeleti — durum makinesi Faz 14'te webhook'larla işletilir.
model Subscription {
  id               String             @id @default(uuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
  INCOMPLETE
  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// Faz 04 — CRM: müşteriler, kişiler, servis lokasyonları, ekipman envanteri
// (docs/DATA_MODEL.md; tümü tenant-owned ve RLS ile korunur — migration'a bakın)
// ---------------------------------------------------------------------------

/// Müşteri (firma veya bireysel). nameNormalized: büyük harf + sıkıştırılmış
/// boşluk — çift kayıt dedektörünün tekil anahtarıdır.
model Customer {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  customerType   CustomerType   @default(COMPANY)
  name           String
  nameNormalized String
  /// VKN/TCKN — opsiyonel. Alan düzeyi şifreleme Faz 15 kapsamında (kısıt kaydı).
  taxId          String?
  status         CustomerStatus @default(ACTIVE)
  billingAddress String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contacts        Contact[]
  serviceLocations ServiceLocation[]
  assets          Asset[]
  crmEvents       CrmEvent[]

  @@unique([tenantId, nameNormalized])
  @@index([tenantId, status, createdAt])
  @@map("customers")
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
  @@map("customer_status")
}

/// Müşteri kontak kişisi. Bildirim tercihleri Faz 12'ye kadar boş kalır.
model Contact {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  name              String
  email             String
  emailNormalized   String
  phone             String?
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, customerId, emailNormalized])
  @@index([tenantId, customerId])
  @@map("contacts")
}

/// Servis lokasyonu — müşteriye bağlı fiziksel adres (+ isteğe bağlı koordinat).
model ServiceLocation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  name        String?
  address     String
  city        String?
  district    String?
  postalCode  String?
  /// Koordinatlar derece cinsinden (±180/±90). PostGIS yerine iki sütun —
  /// basit ve yeterli; hassasiyet ~1m (6 ondalık).
  latitude    Float?
  longitude   Float?
  accessNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@index([tenantId, customerId])
  @@map("service_locations")
}

/// Ekipman/varlık kaydı. assetTag kiracı içinde tekildir (QR kodun taşıdığı
/// kimlik). Hiyerarşi: parentAsset ile alt ekipman ilişkisi.
model Asset {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  serviceLocationId String?
  serviceLocation   ServiceLocation?  @relation(fields: [serviceLocationId], references: [id])
  parentAssetId     String?
  parentAsset       Asset?            @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets       Asset[]           @relation("AssetHierarchy")
  assetTag          String
  serialNumber      String?
  manufacturer      String?
  model             String?
  installedAt       DateTime?
  warrantyUntil     DateTime?
  status            AssetStatus       @default(ACTIVE)
  criticality       AssetCriticality  @default(LOW)
  metadataJson      Json              @default("{}")
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  documents AssetDocument[]
  crmEvents CrmEvent[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status])
  @@map("assets")
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
  @@map("asset_status")
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  @@map("asset_criticality")
}

/// Varlık dokümanı — obje deposundaki dosyanın kiracı kapsamlı meta verisi.
/// objectKey: tenants/{tenantId}/assets/{assetId}/{uuid} (opak, imzalı URL ile erişim).
model AssetDocument {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id])
  objectKey    String
  documentType String
  fileName     String?
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, assetId])
  @@map("asset_documents")
}

/// CRM olay kaydı — müşteri zaman çizelgesi VE varlık geçmişinin tek kaynağı.
/// eventType örnekleri: customer.created, customer.updated, contact.created,
/// location.created, asset.created, asset.status_changed, asset.location_changed,
/// asset.document_added, asset.imported.
model CrmEvent {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  assetId      String?
  asset        Asset?    @relation(fields: [assetId], references: [id])
  eventType    String
  actorId      String?
  requestId    String?
  metadataJson Json     @default("{}")
  occurredAt   DateTime @default(now())

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, assetId, occurredAt])
  @@map("crm_events")
}
