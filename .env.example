NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
WORKER_HEALTH_URL=http://localhost:4001/health

# PostgreSQL (compose veya pnpm infra:native)
# İKİ ROL (RLS için zorunlu — süper kullanıcı satır güvenliğini atlar):
#   teknikflow_app : uygulama çalışma zamanı (NOSUPERUSER, RLS'e tabi)
#   teknikflow     : bootstrap sahibi — yalnız migration/DDL
DATABASE_URL=postgresql://teknikflow_app:local_dev_only@localhost:5432/teknikflow
MIGRATION_DATABASE_URL=postgresql://teknikflow:local_dev_only@localhost:5432/teknikflow
# Entegrasyon testleri ayrı db isterse (opsiyonel; boşsa DATABASE_URL kullanılır)
# TEST_DATABASE_URL=postgresql://teknikflow_app:local_dev_only@localhost:5432/teknikflow_test
# Entegrasyon testleri ayrı db isterse (opsiyonel; boşsa DATABASE_URL kullanılır)
# TEST_DATABASE_URL=postgresql://teknikflow:local_dev_only@localhost:5432/teknikflow_test

# Redis (compose veya pnpm infra:native)
REDIS_URL=redis://localhost:6379

# S3-uyumlu obje deposu (yerelde RustFS; MinIO OSS Nisan 2026'da arşivlendi)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teknikflow-private
S3_ACCESS_KEY=local_s3_user
S3_SECRET_KEY=local_s3_password_change_me

# Worker
WORKER_PORT=4001
HEARTBEAT_INTERVAL_MS=30000

# Faz 03 — kimlik doğrulama / oturum
# Yerel geliştirme için üretilmiş rastgele anahtar (üretimde secret manager)
AUTH_JWT_SECRET=change_me_min_32_chars_local_placeholder
AUTH_SESSION_TTL_HOURS=12
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_INVITE_TTL_HOURS=72
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX=10

# Demo kiracı tohumu (yalnız geliştirme; üretimde tohumlanmaz)
DEMO_SEED_PASSWORD=Atlas!2026
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=local_mock_secret_only
EMAIL_PROVIDER=mailpit
PUSH_PROVIDER=mock
